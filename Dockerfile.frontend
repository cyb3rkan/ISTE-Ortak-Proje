# =============================================================================
# IOC Enricher — frontend (React/Vite) image
#
# Multi-stage:
#   builder  — npm ci + vite build -> static assets.
#   runtime  — nginx serving the static bundle + proxying /api to the backend.
#
# Build from the repository root:
#   docker build -f docker/Dockerfile.frontend -t ioc-enricher-frontend:test .
#
# VITE_* values are PUBLIC (inlined into the JS bundle). Never pass a secret
# as a build arg — there are none here, only the API base path and auth mode.
# =============================================================================

# ---- builder ----------------------------------------------------------------
# Base images are pinned by version tag *and* multi-arch index digest;
# Dependabot (docker ecosystem, /docker) proposes tag/digest bumps as pull
# requests. Node 24 is an LTS line (end of life 2028-04-30); Node 20 reached
# end of life on 2026-04-30. Keep in step with NODE_VERSION in
# .github/workflows/ci.yml.
FROM node:24.22.1-alpine@sha256:06d7adf3e0ef61a13f1d28682726366f97a15aa1888c934d3ecec86c33918b53 AS builder

WORKDIR /app

# Build args reach the RUN steps as environment variables; there is no ENV, so
# nothing is persisted in the builder image configuration.
# VITE_API_BASE_URL is left empty by default so the bundle uses *relative*
# /api URLs, which nginx then proxies to the backend (same-origin -> no CORS).
ARG VITE_API_BASE_URL=""
# UI auth mode ("jwt" | "disabled") that becomes VITE_AUTH_MODE in the bundle.
# Its "public" name token tells BuildKit's SecretsUsedInArgOrEnv check that the
# value is not a secret (the "auth" token alone trips it), so that check stays
# on for every other ARG/ENV instead of being skipped for the file.
ARG PUBLIC_AUTH_MODE="jwt"

COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci

COPY frontend/ ./
RUN VITE_AUTH_MODE="$PUBLIC_AUTH_MODE" npm run build

# ---- runtime ----------------------------------------------------------------
# nginx 1.30 is the current stable branch (even minor); 1.27 was a mainline
# branch and is no longer maintained.
FROM nginx:1.30.6-alpine@sha256:47928bf67eb62a1863cb08d9ecb52d3e704304ba614eaee17884204677702951 AS runtime

# Replace the stock config with our hardened, API-proxying one.
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/dist /usr/share/nginx/html

# Run nginx as the image's unprivileged "nginx" user (uid/gid 101). The main
# config's pid file moves to /tmp (conf.d/default.conf keeps the temp files
# there); its "user" directive only means something to a root master. The grep
# fails the build if the stock config ever stops matching.
RUN sed -i -e 's|^[[:space:]]*pid[[:space:]].*|pid /tmp/nginx.pid;|' \
        -e '/^[[:space:]]*user[[:space:]]/d' /etc/nginx/nginx.conf \
    && grep -q '^pid /tmp/nginx.pid;$' /etc/nginx/nginx.conf
USER 101:101

# Unprivileged port; docker-compose.yml maps host 3000 -> 8080.
EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
    CMD wget -qO- http://127.0.0.1:8080/ >/dev/null 2>&1 || exit 1
