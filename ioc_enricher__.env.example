# ============================================================
#  IOC Enricher Agent — Environment Configuration Template
#  Copy to .env and fill in your API keys.
#  NEVER commit your real .env file to version control.
# ============================================================

# ── Threat Intelligence Provider Keys ──────────────────────
# At least one is required for enrichment to produce results.

VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
SHODAN_API_KEY=
OTX_API_KEY=
GREYNOISE_API_KEY=
ZEROBOUNCE_API_KEY=

# ── Optional: Groq AI Analysis Layer ───────────────────────
# Groq is the only supported AI backend (no OpenAI integration).
# Leave GROQ_API_KEY empty to disable AI narrative generation, or set
# AI_PROVIDER=disabled to force it off. The narrative NEVER changes the
# risk score. Get a key at https://console.groq.com/keys

AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-20b
GROQ_MAX_TOKENS=1200
GROQ_TEMPERATURE=0.2
GROQ_TIMEOUT_SECONDS=30

# ── Caching ────────────────────────────────────────────────

ENABLE_CACHE=true
CACHE_TTL_HOURS=24
# Size limit of the cache directory; expired entries and, above the limit,
# the oldest ones are pruned automatically (at most every 10 minutes).
CACHE_MAX_SIZE_MB=100

# ── Web reports (reports/web) ──────────────────────────────

# Reports older than this, and the oldest ones above the size limit, are
# pruned automatically (at most hourly, when a report is saved).
REPORT_RETENTION_DAYS=30
REPORT_MAX_TOTAL_MB=200

# ── HTTP Settings ──────────────────────────────────────────

REQUEST_TIMEOUT=30
# Provider calls in flight at once, shared by all enrichments of the process.
MAX_CONCURRENT_REQUESTS=5
# Time budget per IOC for the provider phase (seconds, 0 = off). Providers
# still unanswered are reported as "timeout"; answers already in are kept.
IOC_DEADLINE_SECONDS=60
# Longest a provider call waits for a rate-limit slot before it answers
# "rate_limited" instead of waiting (seconds).
RATE_LIMIT_MAX_WAIT_SECONDS=20
# Optional per-minute pacing overrides: Name=requests_per_minute[:burst];...
# Defaults: VirusTotal=4:4 (public API rate), every other provider 60:10.
# Daily/weekly quotas depend on your subscription: they are honoured through
# the provider's HTTP 429 + Retry-After (each pause capped at 1 hour).
# PROVIDER_RATE_LIMITS=VirusTotal=4:4;AlienVault OTX=60:10

# ── Logging ────────────────────────────────────────────────

LOG_LEVEL=INFO
# Empty LOG_FILE = console only. The file is created by the first record.
LOG_FILE=logs/ioc_enricher.log
# Rotation: at most LOG_MAX_BYTES per file and LOG_BACKUP_COUNT old files.
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5
# IOCs are logged as fingerprints; secrets, e-mails and URL query strings are
# masked in every log line. Colour only on an interactive terminal (NO_COLOR=1 disables it).
